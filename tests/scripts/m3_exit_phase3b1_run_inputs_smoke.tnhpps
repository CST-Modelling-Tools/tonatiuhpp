// M3 exit Phase 3B1: same script in native GUI and true-headless mode.
// WARNING: Clears the active scene. Save GUI work before running.
// Fixed GUI seed 0. 64x48 sun grid, 128 interception rays, no GUI Run/export or benchmark.
var root = new NodeObject;
root.setName('M3_Phase3B1');
var receiver = root.createNode('Receiver');
var shape = receiver.createShape();
shape.setName('Shape');
shape.insertSurface('Planar');
var profile = shape.insertProfile('Box');
profile.setParameter('uSize', '8');
profile.setParameter('vSize', '8');
shape.insertMaterial('Absorber');

tn.Clear();
tn.InsertScene(root);
var receiverUrl = '//Node/M3_Phase3B1/Receiver';
var shapeUrl = receiverUrl + '/Shape';
tn.SetValue(receiverUrl, 'translation', '0 0 1');
var translation = receiver.getParameter('translation').trim();
if (translation !== '0 0 1')
    throw new Error('M3 Phase 3B1 field edit did not round-trip.');
var sun = tn.getScene().getPart('world.sun.position');
if (!sun) throw new Error('M3 Phase 3B1 scene sun is missing.');
sun.setParameter('azimuth', '180');
sun.setParameter('elevation', '90');

// Configure the shared legacy Run ray count. This does not invoke GUI
// photon-export Run(), and FindInterception retains its explicit ray argument.
tn.SetRaysNumber(128);
tn.SetRaysGrid(64, 48);
var power = tn.FindInterception(shapeUrl, 128);
if (typeof power !== 'number' || !isFinite(power) || power <= 0)
    throw new Error('M3 Phase 3B1 intercepted power is not positive and finite.');

var csv = new DataObject;
csv.addRow('schema,m3-exit-phase3b1-v1');
csv.addRow('surface,' + shapeUrl);
csv.addRow('rays,128');
csv.addRow('run_rays,128');
csv.addRow('sun_grid,64x48');
csv.addRow('translation,' + translation);
csv.addRow('power_w,' + power.toPrecision(17));
if (!csv.write('m3_exit_phase3b1_result.csv'))
    throw new Error('M3 Phase 3B1 result CSV could not be written.');
var roundTrip = new DataObject;
if (!roundTrip.read('m3_exit_phase3b1_result.csv') || roundTrip.rows() !== 7 ||
    roundTrip.row(6) !== 'power_w,' + power.toPrecision(17))
    throw new Error('M3 Phase 3B1 CSV did not round-trip.');
print('M3 Phase 3B1 run-input smoke passed: ' + power.toPrecision(17));
