// Phase 3B2A shared configuration-only script: no Run(), flux, or file export.
// The script is identical in GUI and true-headless hosts. It never traces rays.
tn.SetRaysNumber(128);
tn.SetRaysGrid(64, 48);
tn.SetExportPhotonMapType('No export');
tn.SetExportCoordinates(true, true);
tn.SetExportIntersectionSurface(true);
tn.SetExportIntersectionSurfaceSide(true);
tn.SetExportPreviousNextPhotonID(false);
tn.SetExportTypeParameterValue('Phase3B2ACheck', 'configured-only');
tn.AddExportSurfaceURL('//Node/Receiver');
tn.SetExportAllPhotonMap();
tn.SetPhotonBufferSize(4096);
tn.SetPhotonBufferAppend(false);
print('M3 Phase 3B2A export-option configuration smoke passed.');
