# Run only in CTest build output, never in tracked source/script directories.
foreach(input TEST_EXECUTABLE TEST_SCRIPT OUTPUT_DIR)
  if(NOT DEFINED ${input} OR "${${input}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${input} for Phase 3A smoke")
  endif()
endforeach()
if(NOT EXISTS "${TEST_EXECUTABLE}" OR NOT EXISTS "${TEST_SCRIPT}")
  message(FATAL_ERROR "Phase 3A fixture or executable missing")
endif()
set(script_dir "${OUTPUT_DIR}/script")
file(MAKE_DIRECTORY "${script_dir}")
set(script_path "${script_dir}/m3_exit_phase3a_field_grid_smoke.tnhpps")
file(COPY_FILE "${TEST_SCRIPT}" "${script_path}" ONLY_IF_DIFFERENT)
set(result_path "${script_dir}/m3_exit_phase3a_result.csv")
set(baseline_path "${OUTPUT_DIR}/headless_baseline.csv")
# Deliberately invalidate old GUI and headless results before running.
file(REMOVE "${result_path}" "${baseline_path}")
execute_process(
  COMMAND "${TEST_EXECUTABLE}"  run-script "${script_path}"
  WORKING_DIRECTORY "${OUTPUT_DIR}"
  RESULT_VARIABLE outcome OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic
  TIMEOUT 65)
if(NOT "${outcome}" STREQUAL "0")
  message(FATAL_ERROR "Phase 3A headless smoke failed (${outcome})\n${output}\n${diagnostic}")
endif()
string(FIND "${output}" "M3 Phase 3A field/grid smoke passed:" found)
if(found EQUAL -1)
  message(FATAL_ERROR "Phase 3A completion marker missing: ${output}")
endif()
if(NOT EXISTS "${result_path}")
  message(FATAL_ERROR "Phase 3A script did not produce a scientific result")
endif()
file(STRINGS "${result_path}" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 6)
  message(FATAL_ERROR "Phase 3A CSV row count changed: ${row_count}")
endif()
file(RENAME "${result_path}" "${baseline_path}")
message(STATUS "Phase 3A true-headless six-row baseline prepared: ${baseline_path}")
message(STATUS "Open the identical copied script in the native GUI, then compare")
