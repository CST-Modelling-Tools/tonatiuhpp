# A CTest-only helper. Clear exactly one named child of an existing configured
# test binary root; reject arbitrary directories, aliases and redirected links.
function(tonatiuhpp_prepare_test_output output_dir build_root leaf)
  if("${output_dir}" STREQUAL "" OR "${build_root}" STREQUAL "" OR "${leaf}" STREQUAL "")
    message(FATAL_ERROR "Test output cleanup requires output_dir, build_root and leaf")
  endif()
  if(NOT IS_ABSOLUTE "${output_dir}" OR NOT IS_ABSOLUTE "${build_root}")
    message(FATAL_ERROR "Test output cleanup requires absolute paths")
  endif()
  if(NOT "${leaf}" MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
    message(FATAL_ERROR "Unsafe test output leaf: ${leaf}")
  endif()
  if(NOT IS_DIRECTORY "${build_root}" OR NOT EXISTS "${build_root}/CTestTestfile.cmake")
    message(FATAL_ERROR "Not a configured CTest binary directory: ${build_root}")
  endif()

  get_filename_component(_requested_abs "${output_dir}" ABSOLUTE)
  get_filename_component(_expected_abs "${build_root}/${leaf}" ABSOLUTE)
  file(TO_CMAKE_PATH "${_requested_abs}" _requested_abs)
  file(TO_CMAKE_PATH "${_expected_abs}" _expected_abs)
  if(NOT _requested_abs STREQUAL _expected_abs)
    message(FATAL_ERROR "Refusing cleanup outside named CTest fixture: ${output_dir}")
  endif()
  if(IS_SYMLINK "${output_dir}")
    message(FATAL_ERROR "Refusing cleanup of a symlinked CTest fixture: ${output_dir}")
  endif()
  if(EXISTS "${output_dir}" AND NOT IS_DIRECTORY "${output_dir}")
    message(FATAL_ERROR "CTest fixture path exists but is not a directory: ${output_dir}")
  endif()

  # Resolve existing path components as an additional check against redirected
  # directory links/junctions, including on Windows. A missing leaf is allowed.
  file(REAL_PATH "${build_root}" _real_root)
  get_filename_component(_real_expected "${_real_root}/${leaf}" ABSOLUTE)
  file(TO_CMAKE_PATH "${_real_expected}" _real_expected)
  if(EXISTS "${output_dir}")
    file(REAL_PATH "${output_dir}" _real_actual)
    file(TO_CMAKE_PATH "${_real_actual}" _real_actual)
    if(NOT _real_actual STREQUAL _real_expected)
      message(FATAL_ERROR "Refusing redirected CTest fixture: ${output_dir}")
    endif()
  endif()
  file(REMOVE_RECURSE "${output_dir}")
  file(MAKE_DIRECTORY "${output_dir}")
endfunction()
