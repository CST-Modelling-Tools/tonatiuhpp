# M5: real frozen-heliostat benchmark; do not compare fewer rays to 500M.
foreach(_required IN ITEMS TEST_EXECUTABLE SOURCE_CONFIG SCENE_FILE OUTPUT_DIR MODE)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "${_required} is required.")
  endif()
endforeach()
foreach(_path IN ITEMS TEST_EXECUTABLE SOURCE_CONFIG SCENE_FILE)
  if(NOT EXISTS "${${_path}}")
    message(FATAL_ERROR "Missing ${_path}: ${${_path}}")
  endif()
endforeach()
if(MODE STREQUAL "smoke")
  set(_rays 10000)
  set(_runs 1)
  set(_timeout 240)
elseif(MODE STREQUAL "repeatability")
  set(_rays 1000000)
  set(_runs 2)
  set(_timeout 540)
elseif(MODE STREQUAL "full")
  # Explicit, long-running release gate; never registered with CTest/CI.
  set(_rays 500000000)
  set(_runs 1)
  set(_timeout 3600)
else()
  message(FATAL_ERROR "Unsupported M5 MODE=${MODE}")
endif()

file(READ "${SOURCE_CONFIG}" _base)
string(JSON _benchmark ERROR_VARIABLE _error GET "${_base}" benchmark)
if(NOT "${_error}" STREQUAL "NOTFOUND" OR NOT "${_benchmark}" STREQUAL "benchmark_v1")
  message(FATAL_ERROR "Expected published benchmark_v1 config.")
endif()
string(JSON _seed GET "${_base}" seed)
string(JSON _side GET "${_base}" target_side_id)
string(JSON _width GET "${_base}" target_grid width)
string(JSON _height GET "${_base}" target_grid height)
string(JSON _no_export GET "${_base}" photon_export)
if(NOT "${_seed}" STREQUAL "123456789" OR NOT "${_side}" STREQUAL "1" OR
   NOT "${_width}" STREQUAL "100" OR NOT "${_height}" STREQUAL "100" OR _no_export)
  message(FATAL_ERROR "Published seed, side, grid or no-export contract changed.")
endif()

# The published 500M reference hash is inapplicable to 10K and 1M runs.
string(JSON _base ERROR_VARIABLE _error REMOVE "${_base}" reference_file)
if(NOT "${_error}" STREQUAL "NOTFOUND")
  message(FATAL_ERROR "Published example did not contain reference_file.")
endif()
if(MODE STREQUAL "full")
  get_filename_component(_source_dir "${SOURCE_CONFIG}" DIRECTORY)
  file(TO_CMAKE_PATH "${_source_dir}/benchmark_reference_500M_v2.json" _reference_file)
  if(NOT EXISTS "${_reference_file}")
    message(FATAL_ERROR "Published 500M reference JSON not found.")
  endif()
  string(JSON _base SET "${_base}" reference_file "\"${_reference_file}\"")
endif()

string(RANDOM LENGTH 10 ALPHABET "0123456789abcdef" _id)
file(TO_CMAKE_PATH "${SCENE_FILE}" _scene)
set(_folder "${OUTPUT_DIR}/m5_${MODE}_${_id}")
file(MAKE_DIRECTORY "${_folder}")
set(_workdir)
if(DEFINED TEST_WORKING_DIRECTORY AND NOT "${TEST_WORKING_DIRECTORY}" STREQUAL "")
  set(_workdir WORKING_DIRECTORY "${TEST_WORKING_DIRECTORY}")
endif()

foreach(_run RANGE 1 ${_runs})
  file(TO_CMAKE_PATH "${_folder}/config_${_run}.json" _config_path)
  file(TO_CMAKE_PATH "${_folder}/result_${_run}.json" _result_path)
  file(TO_CMAKE_PATH "${_folder}/grid_${_run}.bin" _bin_path)
  file(TO_CMAKE_PATH "${_folder}/grid_${_run}.csv" _csv_path)
  set(_config "${_base}")
  string(JSON _config SET "${_config}" rays "${_rays}")
  string(JSON _config SET "${_config}" scene_file "\"${_scene}\"")
  string(JSON _config SET "${_config}" output_file "\"${_result_path}\"")
  string(JSON _config SET "${_config}" flux_grid_binary_output_file "\"${_bin_path}\"")
  string(JSON _config SET "${_config}" flux_grid_output_file "\"${_csv_path}\"")
  file(WRITE "${_config_path}" "${_config}\n")
  execute_process(
    COMMAND "${TEST_EXECUTABLE}" --headless benchmark "${_config_path}"
    ${_workdir}
    RESULT_VARIABLE _exit
    OUTPUT_VARIABLE _stdout
    ERROR_VARIABLE _stderr
    TIMEOUT ${_timeout}
  )
  if(NOT "${_exit}" STREQUAL "0")
    message(STATUS "stdout:\n${_stdout}\nstderr:\n${_stderr}")
    message(FATAL_ERROR "M5 ${MODE} process ${_run} exited ${_exit}")
  endif()
  foreach(_text IN ITEMS "Benchmark completed." "photon_export: false" "export_path: none" "rays_traced: ${_rays}")
    string(FIND "${_stdout}" "${_text}" _found)
    if(_found EQUAL -1)
      message(FATAL_ERROR "M5 ${MODE} run ${_run} missing output '${_text}':\n${_stdout}")
    endif()
  endforeach()
  if(NOT EXISTS "${_result_path}" OR NOT EXISTS "${_bin_path}" OR NOT EXISTS "${_csv_path}")
    message(FATAL_ERROR "M5 ${MODE} run ${_run} missing output JSON, grid or CSV.")
  endif()
  file(READ "${_result_path}" _result)
  foreach(_field IN ITEMS benchmark rays seed chunk_count chunk_size
      total_power_mw minimum_flux_mw_m2 average_flux_mw_m2
      maximum_flux_mw_m2 flux_grid_sha256)
    string(JSON _value ERROR_VARIABLE _json_error GET "${_result}" "${_field}")
    if(NOT "${_json_error}" STREQUAL "NOTFOUND")
      message(FATAL_ERROR "M5 invalid result field ${_field}: ${_json_error}")
    endif()
    if(_run EQUAL 1)
      set("_first_${_field}" "${_value}")
    elseif(NOT "${_value}" STREQUAL "${_first_${_field}}")
      message(FATAL_ERROR "M5 independent processes disagree on ${_field}: '${_first_${_field}}' != '${_value}'")
    endif()
    if(_field STREQUAL "flux_grid_sha256")
      set(_hash "${_value}")
      string(LENGTH "${_hash}" _len)
      if(NOT _len EQUAL 64 OR NOT "${_hash}" MATCHES "^[a-fA-F0-9]+$")
        message(FATAL_ERROR "M5 invalid reported SHA-256: ${_hash}")
      endif()
    endif()
  endforeach()
  math(EXPR _chunks "(${_rays} + 9999) / 10000")
  if(NOT "${_first_benchmark}" STREQUAL "benchmark_v1" OR
     NOT "${_first_seed}" STREQUAL "123456789" OR
     NOT "${_first_rays}" STREQUAL "${_rays}" OR
     NOT "${_first_chunk_count}" STREQUAL "${_chunks}" OR
     NOT "${_first_chunk_size}" STREQUAL "10000")
    message(FATAL_ERROR "M5 benchmark seed, identity, ray count or scheduler chunk count differs.")
  endif()
  string(JSON _width GET "${_result}" target_grid width)
  string(JSON _height GET "${_result}" target_grid height)
  if(NOT "${_width}" STREQUAL "100" OR NOT "${_height}" STREQUAL "100")
    message(FATAL_ERROR "M5 output receiver dimensions differ from 100x100.")
  endif()
  file(SIZE "${_bin_path}" _binary_size)
  file(SHA256 "${_bin_path}" _binary_sha)
  if(NOT _binary_size EQUAL 80000 OR NOT "${_binary_sha}" STREQUAL "${_hash}")
    message(FATAL_ERROR "M5 binary grid size or SHA-256 differs from result JSON.")
  endif()

  string(JSON _benchmark_pass ERROR_VARIABLE _reference_error GET "${_result}" benchmark_pass)
  if(MODE STREQUAL "full")
    if(NOT "${_reference_error}" STREQUAL "NOTFOUND" OR NOT _benchmark_pass)
      message(FATAL_ERROR "Full 500M benchmark failed published reference comparison.")
    endif()
    string(JSON _hash_pass GET "${_result}" flux_grid_hash_matches)
    if(NOT _hash_pass)
      message(FATAL_ERROR "Full 500M reference flux-grid SHA-256 mismatch.")
    endif()
  elseif("${_reference_error}" STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Reduced-ray test unexpectedly compared to the 500M reference.")
  endif()
  message(STATUS "M5 ${MODE} process ${_run}: ${_rays} rays; flux SHA-256 ${_hash}")
endforeach()
message(STATUS "M5 authentic heliostat ${MODE} PASSED; outputs: ${_folder}")
