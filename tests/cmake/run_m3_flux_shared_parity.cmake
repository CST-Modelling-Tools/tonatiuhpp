# Run the same bounded 8-argument flux script twice in independent headless
# processes, verify output shape and byte repeatability, and retain baseline
# files for a subsequent REAL GUI Script Editor comparison.
foreach(required TEST_EXECUTABLE TEST_SCRIPT OUTPUT_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "M3 flux parity requires ${required}")
  endif()
endforeach()
if(NOT EXISTS "${TEST_EXECUTABLE}" OR NOT EXISTS "${TEST_SCRIPT}")
  message(FATAL_ERROR "M3 flux parity test executable or script is missing")
endif()
set(script_dir "${OUTPUT_DIR}/script")
set(other_dir "${OUTPUT_DIR}/elsewhere")
set(script_file "${script_dir}/m3_flux_shared_parity.tnhpps")
file(MAKE_DIRECTORY "${script_dir}" "${other_dir}")
configure_file("${TEST_SCRIPT}" "${script_file}" COPYONLY)
foreach(side front back)
  set(output_${side} "${script_dir}/m3_flux_${side}.txt")
  set(expected_${side} "${OUTPUT_DIR}/headless_${side}_expected.txt")
  file(REMOVE "${output_${side}}" "${expected_${side}}")
endforeach()

foreach(attempt RANGE 1 2)
  execute_process(
    COMMAND "${TEST_EXECUTABLE}" --headless run-script "${script_file}"
    WORKING_DIRECTORY "${other_dir}"
    RESULT_VARIABLE outcome OUTPUT_VARIABLE stdout_text ERROR_VARIABLE stderr_text
    TIMEOUT 85)
  if(NOT "${outcome}" STREQUAL "0")
    message(FATAL_ERROR "M3 flux headless attempt ${attempt} failed (${outcome}):\n${stdout_text}\n${stderr_text}")
  endif()
  if(NOT stdout_text MATCHES "M3 integrated fixed-seed flux parity script passed")
    message(FATAL_ERROR "M3 flux completion marker missing: ${stdout_text}")
  endif()
  foreach(side front back)
    if(NOT EXISTS "${output_${side}}")
      message(FATAL_ERROR "M3 flux ${side} output not produced on attempt ${attempt}")
    endif()
    file(STRINGS "${output_${side}}" grid_rows)
    list(LENGTH grid_rows row_count)
    if(NOT row_count EQUAL 8)
      message(FATAL_ERROR "Expected 8 ${side} grid rows, found ${row_count}")
    endif()
    set(cell_total 0)
    set(saw_positive FALSE)
    foreach(row IN LISTS grid_rows)
      string(REGEX MATCHALL "[^\t]+" values "${row}")
      # Each legacy row has exactly 8 nonempty values; the TSV writer
      # supplies a trailing tab, ignored by the numeric-token regex.
      list(LENGTH values value_count)
      if(NOT value_count EQUAL 8)
        message(FATAL_ERROR "Expected 8 ${side} flux values per row, got ${value_count}: ${row}")
      endif()
      foreach(cell IN LISTS values)
        if(NOT cell MATCHES "^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$")
          message(FATAL_ERROR "Nonfinite or negative ${side} grid cell: '${cell}'")
        endif()
        if(NOT cell MATCHES "^0+([.]0+)?$")
          set(saw_positive TRUE)
        endif()
        math(EXPR cell_total "${cell_total} + 1")
      endforeach()
    endforeach()
    if(NOT cell_total EQUAL 64)
      message(FATAL_ERROR "Unexpected ${side} grid size ${cell_total}")
    endif()
    if(side STREQUAL "front" AND NOT saw_positive)
      message(FATAL_ERROR "Front-side M3 flux grid has no positive cell")
    endif()
    file(SHA256 "${output_${side}}" actual_digest)
    if(attempt EQUAL 1)
      set(first_${side} "${actual_digest}")
      configure_file("${output_${side}}" "${expected_${side}}" COPYONLY)
    elseif(NOT actual_digest STREQUAL "${first_${side}}")
      message(FATAL_ERROR "Independent headless processes produced different ${side} grid bytes")
    endif()
    file(REMOVE "${output_${side}}")
  endforeach()
endforeach()
message(STATUS "M3 fixed-seed flux repeatability accepted in true-headless mode")
message(STATUS "GUI parity baseline front: ${expected_front}")
message(STATUS "GUI parity baseline back:  ${expected_back}")
message(STATUS "Open GUI script: ${script_file}")
