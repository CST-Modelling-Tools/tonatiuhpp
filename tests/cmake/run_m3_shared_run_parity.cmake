# M3 shared ScriptRunExecutionService acceptance. Two independent true-headless
# processes write real production File photon exports, then use the repository's
# accepted physical-photon multiset comparator (not order/serialized IDs).
cmake_minimum_required(VERSION 3.21)
foreach(v TEST_EXECUTABLE TEST_SCRIPT TEST_SCENE COMPARATOR OUTPUT_DIR TEST_BUILD_ROOT)
  if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
    message(FATAL_ERROR "M3 shared Run test is missing ${v}")
  endif()
endforeach()
foreach(p TEST_EXECUTABLE TEST_SCRIPT TEST_SCENE COMPARATOR)
  if(NOT EXISTS "${${p}}")
    message(FATAL_ERROR "M3 shared Run missing fixture ${p}: ${${p}}")
  endif()
endforeach()
get_filename_component(expected_output "${TEST_BUILD_ROOT}/m3_shared_run_parity" ABSOLUTE)
get_filename_component(actual_output "${OUTPUT_DIR}" ABSOLUTE)
file(TO_CMAKE_PATH "${expected_output}" expected_output)
file(TO_CMAKE_PATH "${actual_output}" actual_output)
if(NOT "${expected_output}" STREQUAL "${actual_output}")
  message(FATAL_ERROR "M3 shared Run refuses a non-fixture output folder: ${OUTPUT_DIR}")
endif()
find_program(M3_SHARED_RUN_PYTHON NAMES python3 python REQUIRED)

# Deleting only this exact, disposable CTest-owned directory; it is always
# regenerated by the test. Never delete the user's source or unknown paths.
file(REMOVE_RECURSE "${OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/script")
file(TO_CMAKE_PATH "${TEST_SCENE}" scene_path)
file(READ "${TEST_SCRIPT}" script_template)
foreach(side headless_first headless_second gui)
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${side}")
  file(TO_CMAKE_PATH "${OUTPUT_DIR}/${side}" export_path)
  string(REPLACE "@SCENE_FILE@" "${scene_path}" script_content "${script_template}")
  string(REPLACE "@EXPORT_DIRECTORY@" "${export_path}" script_content "${script_content}")
  file(WRITE "${OUTPUT_DIR}/script/m3_shared_run_${side}.tnhpps" "${script_content}")
endforeach()
# A separate native GUI negative script deliberately targets an ABSENT folder.
# Never create it: a valid shared ScriptRunExecutionService must fail closed.
file(TO_CMAKE_PATH "${OUTPUT_DIR}/missing_dir_do_not_create" missing_output)
string(REPLACE "@SCENE_FILE@" "${scene_path}" missing_script "${script_template}")
string(REPLACE "@EXPORT_DIRECTORY@" "${missing_output}" missing_script "${missing_script}")
file(WRITE "${OUTPUT_DIR}/script/m3_shared_run_gui_missing_dir.tnhpps" "${missing_script}")
if(EXISTS "${OUTPUT_DIR}/missing_dir_do_not_create")
  message(FATAL_ERROR "Missing-folder test fixture unexpectedly exists")
endif()

foreach(side headless_first headless_second)
  execute_process(
    COMMAND "${TEST_EXECUTABLE}" --headless run-script
      "${OUTPUT_DIR}/script/m3_shared_run_${side}.tnhpps"
    WORKING_DIRECTORY "${OUTPUT_DIR}/script"
    RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
    TIMEOUT 110)
  if(NOT "${code}" STREQUAL "0" OR
      NOT stdout MATCHES "M3 shared Run File append completed")
    message(FATAL_ERROR "M3 shared Run ${side} failed (${code}):\n${stdout}\n${stderr}")
  endif()
  if(NOT EXISTS "${OUTPUT_DIR}/${side}/PhotonMap.dat" OR
      NOT EXISTS "${OUTPUT_DIR}/${side}/PhotonMap_parameters.txt")
    message(FATAL_ERROR "M3 shared Run ${side} lacks real File photon output")
  endif()
endforeach()

execute_process(
  COMMAND "${M3_SHARED_RUN_PYTHON}" "${COMPARATOR}"
    "${OUTPUT_DIR}/headless_first" "${OUTPUT_DIR}/headless_second"
  RESULT_VARIABLE compare_code OUTPUT_VARIABLE compare_out ERROR_VARIABLE compare_err)
if(NOT "${compare_code}" STREQUAL "0")
  message(FATAL_ERROR "M3 shared Run physical-photon mismatch:\n${compare_out}\n${compare_err}")
endif()
message(STATUS "M3 two-process real shared Run append parity passed: ${compare_out}")
message(STATUS "M3 GUI Script Editor parity fixture: ${OUTPUT_DIR}/script/m3_shared_run_gui.tnhpps")
message(STATUS "Compare GUI photon export against: ${OUTPUT_DIR}/headless_first")
